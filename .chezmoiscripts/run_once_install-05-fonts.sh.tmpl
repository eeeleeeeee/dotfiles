{{- if and (ne .chezmoi.os "windows") (not .isWSL) -}}
#!/usr/bin/env bash
set -euo pipefail

echo "=== Fonts Setup ==="
echo "(Linux only — WSL 自動跳過，因為終端字型由 Windows 端管)"

FONTS_DIR="$HOME/.local/share/fonts"
mkdir -p "$FONTS_DIR"

# 從 Nerd Fonts release 抓單字型 zip 解到 ~/.local/share/fonts/。pattern 用
# 來 idempotency check：若該字型某個變體已經在，就跳過下載。
install_nerd_font() {
    local zip_name="$1" idempotency_pattern="$2"
    if compgen -G "$FONTS_DIR/$idempotency_pattern" > /dev/null; then
        echo "[$zip_name] already installed, skipping."
        return
    fi
    echo "[$zip_name] Downloading from Nerd Fonts latest release..."
    local tmp_zip
    tmp_zip=$(mktemp --suffix=.zip)
    curl -fsSL -o "$tmp_zip" \
        "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/${zip_name}.zip"
    unzip -qo "$tmp_zip" -d "$FONTS_DIR"
    rm -f "$tmp_zip"
}

# ── Nerd Fonts ────────────────────────────────────────────────────────────
# CascadiaCode.zip 內含 CaskaydiaCove-* 系列（Nerd Fonts 把 Cascadia 變體叫
# 這個名字以避商標衝突）
install_nerd_font "CascadiaCode"  "CaskaydiaCoveNerdFont-*.ttf"
install_nerd_font "JetBrainsMono" "JetBrainsMonoNerdFont-*.ttf"
install_nerd_font "Noto"          "NotoSansNerdFont-*.ttf"

# ── Noto CJK（OTC bundle）─────────────────────────────────────────────────
# 中文/日文/韓文 fallback。Nerd Fonts 的 Noto 不含 CJK 字符。
NOTO_CJK="$FONTS_DIR/NotoSansCJK-Regular.ttc"
if [ -f "$NOTO_CJK" ]; then
    echo "[Noto CJK] already installed, skipping."
else
    echo "[Noto CJK] Downloading OTC bundle..."
    curl -fsSL -o "$NOTO_CJK" \
        "https://github.com/notofonts/noto-cjk/raw/main/Sans/OTC/NotoSansCJK-Regular.ttc"
fi

# ── 重建 fontconfig cache ─────────────────────────────────────────────────
echo "[fontconfig] Rebuilding cache..."
fc-cache -f "$FONTS_DIR"

echo "=== Fonts setup complete. ==="
{{- end -}}
